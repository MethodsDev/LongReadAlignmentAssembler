# Ignore Python bytecode cache anywhere in the tree. Was pylib-only, which left
# util/, util/misc/, util/sc/ and the repo root uncovered -- an `add -A` swept 18
# of them into a commit from there.
__pycache__/
*.pyc

# Written to the current working directory by Transcript.py's clustering debug dump,
# so it lands wherever pytest happened to run. Not an input to anything.
__init_clusters.tsv

# Ignore all untracked files generated under testing
testing/**
!testing/lraa_test_docker.mk
!testing/multigene_secondary_quant/
testing/multigene_secondary_quant/**
!testing/multigene_secondary_quant/Makefile
!testing/multigene_secondary_quant/validate_outputs.py
!testing/multigene_secondary_quant/data/
testing/multigene_secondary_quant/data/**
!testing/multigene_secondary_quant/data/annot.gtf
!testing/multigene_secondary_quant/data/genome.fa
!testing/multigene_secondary_quant/data/multigene_secondary.sam
!testing/txalign_path_rescue/
!testing/txalign_path_rescue/Makefile
!testing/txalign_path_rescue/validate_txalign_path_rescue.py
!testing/txalign_path_rescue/microexon/
!testing/txalign_path_rescue/microexon/Makefile
!testing/txalign_path_rescue/microexon/*/
!testing/txalign_path_rescue/microexon/*/Makefile
!testing/txalign_path_rescue/microexon/*/data/
!testing/txalign_path_rescue/microexon/*/data/**
!testing/txalign_path_rescue/repetitive/
!testing/txalign_path_rescue/repetitive/Makefile
!testing/txalign_path_rescue/repetitive/*/
!testing/txalign_path_rescue/repetitive/*/Makefile
!testing/txalign_path_rescue/repetitive/*/data/
!testing/txalign_path_rescue/repetitive/*/data/**
!testing/DTU_eval/
!testing/DTU_eval/testdata/
!testing/DTU_eval/testdata/**
!testing/ont_sep_contigs/
!testing/ont_sep_contigs/minig-ENSG00000066135/
!testing/ont_sep_contigs/minig-ENSG00000066135/data/
!testing/ont_sep_contigs/minig-ENSG00000066135/data/**
!testing/determinism/
!testing/determinism/Makefile
!testing/determinism/check_determinism.py
!testing/internal_priming/
!testing/internal_priming/check_monoexonic_internal_priming.py
!testing/strandless_parity/
!testing/strandless_parity/Makefile
!testing/strandless_parity/run_strandless_gate.py

# EM_alpha sweep: measurement harness plus the small result tables and figure
# it produces. The run outputs themselves (one quant.expr per arm, ~250 arms)
# stay outside the repo; only the scored summaries are tracked, because those
# are what a reviewer needs to re-derive the recommendation without re-running
# 40 core-hours of LRAA.
!testing/EM_alpha_sweep/
!testing/EM_alpha_sweep/*.py
!testing/EM_alpha_sweep/*.md
!testing/EM_alpha_sweep/results/
!testing/EM_alpha_sweep/results/*.tsv
!testing/EM_alpha_sweep/results/*.png

# personal audit working notes; not for distribution
doc_audit/

# tabix indexes LRAA builds beside a reference GTF
*.lraa_tabix.gtf.gz
*.lraa_tabix.gtf.gz.tbi
*.lraa_tabix.json

# staged by Docker/build_docker.*.sh via git archive; regenerated every build
Docker/lraa_checkout.tar.gz
Docker/lraa_checkout.sha

# Editor artefacts. Five were committed in e48fcded -- an Emacs autosave
# (#file#) and four backups (file~) -- and nothing here excluded them.
# Untracked from the index rather than deleted from disk: they are the
# author's working files, they simply are not source.
#
# Safe as broad patterns because, unlike the __* debug-artefact convention
# (which has ~100 legitimately tracked files under testing/sirvs and
# util/sc/__deprecated), NO tracked file in this repo matches either shape
# except the five removed alongside this entry.
*~
\#*\#
.\#*
