# ORF prediction on top of the barebones image: TransDecoder plus the two
# homology-search tools its --blast_tool switch selects.
# Used by WDL/LRAA-ORF-prediction.wdl (util/LRAA_isoforms_to_ORFs.py).

ARG LRAA_CORE_IMAGE=lraa-core:latest

FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get -qq update && apt-get -qq -y install \
    build-essential \
    ca-certificates \
    make \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

ENV TRANSDECODER_VERSION=6.0.0
RUN wget -q https://github.com/TransDecoder/TransDecoder/archive/TransDecoder-v${TRANSDECODER_VERSION}.tar.gz && \
    tar xzf TransDecoder-v${TRANSDECODER_VERSION}.tar.gz && \
    mv TransDecoder-TransDecoder-v${TRANSDECODER_VERSION} /opt/TransDecoder && \
    cd /opt/TransDecoder && make && \
    rm -rf /opt/TransDecoder/__testing /opt/TransDecoder/TransDecoder.wiki

ENV DIAMOND_VERSION=2.1.8
RUN wget -q https://github.com/bbuchfink/diamond/releases/download/v${DIAMOND_VERSION}/diamond-linux64.tar.gz && \
    tar xzf diamond-linux64.tar.gz && \
    mv diamond /opt/diamond

# TransDecoder's blastp path runs exactly these two programs
# (TransDecoder:251,254); the rest of the 672MB release is never invoked.
ENV BLAST_VERSION=2.14.0
RUN wget -q https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/${BLAST_VERSION}/ncbi-blast-${BLAST_VERSION}+-x64-linux.tar.gz && \
    tar xzf ncbi-blast-${BLAST_VERSION}+-x64-linux.tar.gz && \
    mkdir -p /opt/blast && \
    cp ncbi-blast-${BLAST_VERSION}+/bin/blastp ncbi-blast-${BLAST_VERSION}+/bin/makeblastdb /opt/blast/


FROM ${LRAA_CORE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# blastp and makeblastdb link against the OpenMP runtime.
RUN apt-get -qq update && apt-get -qq -y install --no-install-recommends libgomp1 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/TransDecoder /usr/local/src/TransDecoder
COPY --from=builder /opt/diamond /usr/local/bin/diamond
COPY --from=builder /opt/blast/ /usr/local/bin/

ENV TRANSDECODER_DIR=/usr/local/src/TransDecoder
ENV PATH="${TRANSDECODER_DIR}:${PATH}"
