# Barebones LRAA: isoform discovery, quantification, and every WDL task that
# only shuffles LRAA outputs around.  No R, no Seurat, no TransDecoder, no
# BLAST/Diamond -- those live in the derived images built FROM this one.
#
# Two stages: compilers and headers stay in the builder, so the runtime carries
# binaries and interpreters only.

FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get -qq update && apt-get -qq -y install \
    build-essential \
    ca-certificates \
    git \
    libbz2-dev \
    libcurl4-openssl-dev \
    liblzma-dev \
    libncurses-dev \
    libssl-dev \
    make \
    wget \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

ENV SAMTOOLS_VERSION=1.13
RUN wget -q https://github.com/samtools/samtools/releases/download/${SAMTOOLS_VERSION}/samtools-${SAMTOOLS_VERSION}.tar.bz2 && \
    tar xf samtools-${SAMTOOLS_VERSION}.tar.bz2 && \
    cd samtools-${SAMTOOLS_VERSION} && \
    ./configure && make -j"$(nproc)" && make install

ENV HTSLIB_VERSION=1.13
RUN wget -q https://github.com/samtools/htslib/releases/download/${HTSLIB_VERSION}/htslib-${HTSLIB_VERSION}.tar.bz2 && \
    tar xf htslib-${HTSLIB_VERSION}.tar.bz2 && \
    cd htslib-${HTSLIB_VERSION} && \
    ./configure && make -j"$(nproc)" && make install

ENV GFFCOMPARE_VERSION=0.12.6
RUN git clone --depth 1 --branch v${GFFCOMPARE_VERSION} --recurse-submodules https://github.com/gpertea/gffcompare.git && \
    cd gffcompare && make release && \
    cp gffcompare trmap /usr/local/bin/

# Transcriptome read rescue shells out to minimap2 (pylib/IsoformReadRescue.py).
ENV MINIMAP2_VERSION=2.28
RUN wget -q https://github.com/lh3/minimap2/releases/download/v${MINIMAP2_VERSION}/minimap2-${MINIMAP2_VERSION}_x64-linux.tar.bz2 && \
    tar xf minimap2-${MINIMAP2_VERSION}_x64-linux.tar.bz2 && \
    cp minimap2-${MINIMAP2_VERSION}_x64-linux/minimap2 /usr/local/bin/


FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Runtime only: the shared libraries samtools/htslib link against, the perl the
# GTF/BED converters run under (DB_File ships with Ubuntu's perl; URI::Escape is
# liburi-perl), and python.
RUN apt-get -qq update && apt-get -qq -y install --no-install-recommends \
    ca-certificates \
    curl \
    libbz2-1.0 \
    libcurl4t64 \
    libdeflate0 \
    liblzma5 \
    libncursesw6 \
    libssl3t64 \
    liburi-perl \
    perl \
    pigz \
    procps \
    python3 \
    python3-pip \
    zlib1g \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python

ENV SRC=/usr/local/src
ENV BIN=/usr/local/bin

COPY --from=builder /usr/local/bin/ /usr/local/bin/
COPY --from=builder /usr/local/lib/ /usr/local/lib/

# What an LRAA run reaches: pysam, networkx, intervaltree, tqdm, lmdb, psutil,
# numpy (pylib/EM.py), and igraph/leidenalg -- the Leiden partition in
# Transcript.recluster_transcripts_to_genes is on the default discovery path and
# raises ImportError without them, despite the guarded import.
RUN pip install --no-cache-dir --break-system-packages \
    pysam \
    networkx \
    intervaltree \
    tqdm \
    lmdb \
    psutil \
    numpy \
    igraph==0.11.4 \
    leidenalg==0.10.2

WORKDIR $SRC

ENV LRAA_VERSION="v0.18.1"
ENV LRAA_CO=3738823e0b836daa72f9cf7a5862709836a9a0fb

RUN curl -sSL https://github.com/MethodsDev/LongReadAlignmentAssembler/archive/${LRAA_CO}.tar.gz -o lraa.tar.gz && \
    tar xzf lraa.tar.gz && \
    mv LongReadAlignmentAssembler-${LRAA_CO} LRAA && \
    rm -rf lraa.tar.gz LRAA/testing

ENV PATH="$SRC/LRAA/:$SRC/LRAA/util/:$SRC/LRAA/util/sc/:$SRC/LRAA/util/misc:${PATH}"
