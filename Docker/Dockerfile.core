# Barebones LRAA: isoform discovery, quantification, and every WDL task that
# only shuffles LRAA outputs around.  No R, no Seurat, no TransDecoder, no
# BLAST/Diamond; those live in lraa-sc and lraa-orf, which build from the same
# base rather than from this image.
#
# Everything except the LRAA checkout comes from Dockerfile.base.

ARG LRAA_BASE_IMAGE=lraa-base:latest
FROM ${LRAA_BASE_IMAGE}

ARG LRAA_VERSION
ARG LRAA_CO
ENV LRAA_VERSION=${LRAA_VERSION}
ENV LRAA_CO=${LRAA_CO}

# Real provenance, and the only provenance: the SHA the checkout below was
# fetched with.  Readable without running the image, unlike an ENV.
LABEL org.opencontainers.image.revision=${LRAA_CO}

# The last layer, here and in every other image: a version bump must not
# invalidate anything expensive above it.  testing/ is fixture data that only
# the repository's own Makefiles read, from a host checkout, so it is not
# shipped.
RUN if [ -z "${LRAA_CO}" ]; then echo "build arg LRAA_CO is required; the build scripts pass git rev-parse HEAD" >&2; exit 1; fi; \
    cd ${SRC} && \
    curl -fsSL --retry 8 --retry-all-errors --retry-delay 15 https://github.com/MethodsDev/LongReadAlignmentAssembler/archive/${LRAA_CO}.tar.gz -o lraa.tar.gz && \
    tar xzf lraa.tar.gz && \
    mv LongReadAlignmentAssembler-${LRAA_CO} LRAA && \
    rm -rf lraa.tar.gz LRAA/testing
